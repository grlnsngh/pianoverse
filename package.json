{
  "name": "pianoverse",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "plus": "node ./scripts/increment-version.js",
    "build:android": "node ./scripts/build-android.js",
    "publish:apk": "node ./scripts/publish-apk.js",
    "release:android": "node ./scripts/release-android.js",
    "check:appwrite": "node ./scripts/check-appwrite.js",
    "update": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "globalSetup": "<rootDir>/__tests__/helpers/globalSetup.js",
    "setupFiles": [
      "<rootDir>/__tests__/helpers/setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/helpers/photoToken.js"
    ],
    "testTimeout": 30000,
    "transform": {
      "\\.(png|jpg|jpeg|gif|webp)$": "<rootDir>/__tests__/helpers/assetTransformer.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|standard-navigation|react-redux))",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "date-fns": "^4.4.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.16",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.5",
    "expo-print": "~58.0.6",
    "expo-router": "~58.0.23",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "expo-web-browser": "~58.0.6",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-appwrite": "~1.3.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.1.2",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/redux-logger": "^3.0.13",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "react-native-appwrite": {
      "expo-file-system": "~58.0.9",
      "react-native": "0.88.0"
    }
  }
}
