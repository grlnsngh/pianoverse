{
  "expo": {
    "name": "pianoverse",
    "slug": "pianoverse",
    "version": "1.1.13",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pianoverse",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#161622",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#161622"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.grlnsngh.pianoverse",
      "versionCode": 24
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pianoverse uses your photos so you can add pictures of your pianos.",
          "cameraPermission": "Pianoverse uses the camera so you can take pictures of your pianos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9002c527-c408-455a-925b-2d4c09ae3118"
      }
    }
  }
}