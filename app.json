{
  "expo": {
    "name": "pianoverse",
    "slug": "pianoverse",
    "version": "1.1.18",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "pianoverse",
      "appwrite-callback-66b2693000154e2fa3c8"
    ],
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "splash": {
      "backgroundColor": "#FF9C01"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.grlnsngh.pianoverse",
      "versionCode": 29
    },
    "runtimeVersion": "3",
    "updates": {
      "url": "https://u.expo.dev/9002c527-c408-455a-925b-2d4c09ae3118",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pianoverse uses your photos so you can add pictures of your pianos.",
          "cameraPermission": "Pianoverse uses the camera so you can take pictures of your pianos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pianoverse uses Face ID to unlock the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9002c527-c408-455a-925b-2d4c09ae3118"
      }
    }
  }
}
