# Read by Expo when it bundles the app (expo start, EAS Build, eas update).
# No secrets here: everything in this file is committed.

# Keep React Native's own fetch instead of expo/fetch, the default since Expo
# SDK 56. Photo uploads go through the Appwrite SDK, which sends each photo as
# React Native's { uri, name, type } form part, and expo/fetch can't send those.
EXPO_PUBLIC_USE_RN_FETCH=1
